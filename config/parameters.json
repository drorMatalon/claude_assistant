{
    "hooks": {
        "response_start": {
            "enabled": true,
            "handler": "response_start.py"
        },
        "tool_start": {
            "enabled": true,
            "handler": "tool_start.py"
        },
        "tool_end": {
            "enabled": true,
            "handler": "tool_end.py"
        },
        "response_end": {
            "enabled": true,
            "handler": "response_end.py"
        }
    },
    "character": {
        "image_thinking": "data/claude_bot.jpg",
        "image_tool_running": "data/claude_bot_red.png",
        "image_done": "data/claude_bot_green.png",
        "done_seconds": 3,
        "agent_check_seconds": 1,
        "height": 120,
        "margin": 24,
        "port": 50556,
        "position_file": "outputs/character_position.json"
    }
}
